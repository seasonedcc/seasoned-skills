{
  "commands": [
    {
      "description": "Regenerate every generated file from the configuration and project content. Idempotent; fails loud, degrading the project to the repair kit when inputs are broken.",
      "name": "sync",
    },
    {
      "description": "Adopt the workflow: an interactive one-time scaffold of the configuration (asking every option the rulings give no default), the committed artifacts, and the empty content files — finishing with a sync and a doctor report. Never overwrites what exists.",
      "name": "install",
