{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "autoCompactWindow": 330000,
  "autoMemoryEnabled": false,
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh; exit 0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-stash.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-stash.sh; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-write-guard.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-write-guard.sh; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/isolation-guard.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/isolation-guard.sh; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-end-sweep.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-end-sweep.sh; exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-after-compaction.sh ] && exec \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ledger-after-compaction.sh; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
